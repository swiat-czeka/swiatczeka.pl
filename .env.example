# Wymagane do publikowania i zdjęć (Vercel → Storage → Blob dodaje je automatycznie)
BLOB_READ_WRITE_TOKEN=
# Claude (Anthropic): wygładzanie dyktowanych wpisów
ANTHROPIC_API_KEY=
# opcjonalnie: inny model niż domyślny claude-opus-5-5 (np. claude-sonnet-5-5 jest tańszy)
ANTHROPIC_MODEL=
# opcjonalnie: własny sekret sesji (min. 32 znaki); bez niego używany jest sekret pochodny od tokenu Blob
SESSION_SECRET=
# opcjonalnie: inny kanał YouTube niż domyślny (domyślny jest w src/lib/site.ts)
YOUTUBE_CHANNEL_ID=
# opcjonalnie: klucz YouTube Data API v3 (opisy, daty i długość wszystkich filmów na stronie /wideo)
YOUTUBE_API_KEY=
