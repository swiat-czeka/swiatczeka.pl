# Wymagane do publikowania i zdjęć (Vercel → Storage → Blob dodaje je automatycznie)
BLOB_READ_WRITE_TOKEN=
# Wygładzanie dyktowanych wpisów przez AI
OPENAI_API_KEY=
# opcjonalnie: inny model niż domyślny gpt-4o-mini
OPENAI_MODEL=
# opcjonalnie: własny sekret sesji (min. 32 znaki); bez niego używany jest sekret pochodny od tokenu Blob
SESSION_SECRET=
# Statystyki odwiedzin (Vercel → Storage → Upstash Redis dodaje je automatycznie)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vlog: automatyczne wpisy z YouTube (ID kanału zaczyna się od UC) i sekret crona
YOUTUBE_CHANNEL_ID=
CRON_SECRET=
